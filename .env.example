# Broker Selection: angel_one | fyers
BROKER=angel_one

# Mode: LIVE | OFFLINE
MODE=OFFLINE

# Angel One SmartAPI Credentials
API_KEY=
CLIENT_ID=
PASSWORD=
TOTP_SECRET=

# FYERS Credentials (if using FYERS)
